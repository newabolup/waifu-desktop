# Kizuna Desktop AI Companion - Environment Configuration Example
# Copy to .env if you wish to configure fallback default settings

# Optional default OpenAI-compatible API base URL
DEFAULT_AI_BASE_URL=https://api.openai.com/v1

# Optional default model name
DEFAULT_AI_MODEL=gpt-4o-mini

# Optional default API key (Can also be configured directly in the app UI)
# DEFAULT_AI_KEY=your_api_key_here

# App environment
NODE_ENV=development
